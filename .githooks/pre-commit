#!/usr/bin/env bash
# >>> ponygo-gate: adr-verify v1 >>>
if [ -f "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" ]; then
  bash "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" || exit 1
fi
# <<< ponygo-gate: adr-verify v1 <<<
# .githooks/pre-commit - 本地秒级快速门禁
set -euo pipefail

# 0. 凭据扫描（秒级；扫描面 = 已跟踪文件，`git grep` 一次全树约 0.3s）
# 位置：哨兵块（A1 ADR 门）之后、ADR 门之前——凭据泄漏比格式违例更贵，先拦。
# 本仓自写的三段（ADR/ cargo check / doc-freshness）不得因 ponygo init 的哨兵块前置而丢失。
if [ -f .meta/gates/secret-scan.sh ]; then
  bash .meta/gates/secret-scan.sh || exit 1
fi

# 1. 检查 ADR 规范
if [ -d .agents/notes ]; then
  bash .meta/gates/check-adr.sh
fi

# 2. 检查暂存区 Rust 语法与快速格式 (仅对暂存文件)
staged_rs=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)
if [ -n "$staged_rs" ]; then
  cargo check --tests --quiet --workspace
fi

# 3. [doc-freshness WARN] 启发式提醒 (非硬阻断)
staged_src=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.(rs|ts|tsx)$' || true)
staged_doc=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '(\.md$|AGENTS\.md$)' | grep -v '^\.agents/notes/' || true)
if [ -n "$staged_src" ] && [ -z "$staged_doc" ]; then
  echo "=== [doc-freshness WARN] 暂存区有源码变更但无（非-notes）文档更新 ===" >&2
  echo "  改了用户可见行为/契约请同步对应文档的家（same-commit）；纯重构忽略。" >&2
fi

exit 0
