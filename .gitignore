# 凭据文件（600 权限，禁止入库）
.secrets.env

# 真实配置（含 worker_secret，S-P1-2 裁决）；示例文件 config.example.json 入库
config.json
config.json.bak

# 构建产物与 SQLite 运行时文件
/target
*.db
*.db-wal
*.db-shm

# clippy 独立 target 目录（工具链错配环境临时产物）
/target-clippy
.pproxy.env

# M5 desktop（独立构建图）
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# M6 gate worker 本地依赖
deploy/cf-gate-worker/node_modules/
deploy/render-gate/node_modules/

# 2026-08 安全审计整改：本地密钥与运行时/构建产物禁止入库
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db-journal
.vercel/
.env.local

# 根目录与 scripts 的依赖目录
/node_modules/
/scripts/node_modules/

# 根目录 node_modules 符号链接（git 视为文件，带斜杠的目录规则无法匹配）
/node_modules

# AI 工具本地状态（不入库）
.workbuddy/

# 开源前补充：本机运行时快照与本地 LLM 进程文件（git add . 防误提交）
telemetry-snapshot.json
ponyllm.pid
ponyllm-serve.log
ponyllm.toml.bak
desktop/src-tauri/tauri.updater.json

# 本地中继下载的桌面安装包（不入库，用户自行取用）
desktop/releases/

# AI 测试运行产物（2026-10-30 治理修复：gateway-logs/metrics/probe CSV 属运行时采样，
# 可再生产且曾夹带明文凭据；只保留脚本与 .md 结论。解跟踪用 git rm --cached，勿删磁盘文件）
# 规则按**产物目录语义**收窄，不做 `.agents/tests/**/*.txt|*.csv` 的全树扩展名封杀——
# 否则将来放进来的 golden 夹具（如 `golden/expected.txt`）会被迫 `git add -f`，
# 而"必须要 -f 才能入库"的目录最终会长出绕过门的习惯。故只覆盖：日志目录、抓包原文、
# 稳定性跑测各轨的采样文件。
.agents/tests/**/logs/
.agents/tests/stability-*/*/raw/
.agents/tests/stability-*/*/*.csv
.agents/tests/stability-*/*/*.txt
.agents/tests/stability-*/test-token.txt
