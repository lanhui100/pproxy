{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "pony-desktop 授权：通知 + http（scope 通配放行任意 http/https——个人工具威胁模型：无第三方内容渲染、目标地址仅来自用户设置项；CSP connect-src 'none' 未放宽）+ 自定义凭据命令",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
