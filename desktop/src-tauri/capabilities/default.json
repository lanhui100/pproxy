{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "pony-desktop \u6700\u5c0f\u6388\u6743\uff1a\u901a\u77e5 + http\uff08scope \u9501\u5b9a\u7ba1\u7406\u9762\u5730\u5740\uff09+ \u81ea\u5b9a\u4e49\u51ed\u636e\u547d\u4ee4",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://<TAILNET_IP>:8900/*"
        },
        {
          "url": "http://127.0.0.1:8900/*"
        },
        {
          "url": "http://<tailnet-host>:8900/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}