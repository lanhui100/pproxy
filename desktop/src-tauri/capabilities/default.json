{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "pony-desktop 最小授权：通知 + http（scope 锁定管理面地址）+ 自定义凭据命令",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://<TAILNET_IP>:8900/*" },
        { "url": "http://127.0.0.1:8900/*" }
      ]
    }
  ]
}
