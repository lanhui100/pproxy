{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pony-desktop",
  "version": "0.3.0",
  "identifier": "com.ponyjob.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Pony Proxy",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMzM1MTQ1NjZDNjE1RTAKUldUZ0ZjWm1SVkV6R3AxQWVtWmFOQW15NUtoTTR6Q3JXQ0hZZ1N5dVljN0tHaEsxQ2I5U3Q2WjgK",
      "endpoints": [
        "http://<tailnet-host>:8900/dsk/latest.json",
        "http://<TAILNET_IP>:8900/dsk/latest.json"
      ],
      "dangerous_insecure_transport_protocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}